# 값은 여기 적지 말고 .env 에만 넣으세요 (.env 는 gitignore 됩니다).

# ── Meshy image-to-3D ────────────────────────────────────────────────
#   https://www.meshy.ai → Settings → API Keys
MESHY_API_KEY=

# ── TRELLIS.2 (RunPod Serverless) ────────────────────────────────────
#   워커: runpod/  ·  클라이언트: scripts/assets/trellis.mjs
#   RUNPOD_API_KEY 는 ~/.runpod/config.toml 에 이미 있는 값과 같다.
RUNPOD_API_KEY=
RUNPOD_TRELLIS_ENDPOINT=

# 생성 파라미터 (선택 — 기본값은 trellis.mjs 안에 있다)
#   TRELLIS_POLYCOUNT=50000     Meshy target_polycount 와 같은 값. 비교 조건을 맞추려고 고정.
#   TRELLIS_RESOLUTION=1024     512 / 1024 / 1536. 1536 은 A40 에서 60초 이상.
#   TRELLIS_TEXTURE=2048        4096 은 웹에 과하다.
#   TRELLIS_S3_FOLDER=kse/models

# ── AWS ──────────────────────────────────────────────────────────────
# 로컬 스크립트는 aws cli default 프로파일을 그대로 쓴다 — 여기에 키를 넣을 필요 없다.
# 아래는 GLB 를 올릴 버킷 지정용. 정적 호스팅 버킷이라 업로드하면 바로 웹에서 받아진다.
# (RunPod 워커 쪽 자격증명은 코드가 아니라 엔드포인트 Env 에 넣는다)
AWS_S3_BUCKET=kse-global-motion-prototype-pastino
AWS_REGION=ap-northeast-2
